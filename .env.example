PORT=3000
HOST=127.0.0.1
LOCAL_DEV=false
MODEL_PROTOCOL=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3:1.7b
# Optional for OpenAI-compatible providers. Never commit a real key.
MODEL_API_KEY=
# Required: 24+ characters, unless AUTH_USERS_FILE or loopback-only LOCAL_DEV=true.
ADMIN_TOKEN=
MAX_AGENT_STEPS=8
COMMAND_TIMEOUT_MS=30000
MODEL_TIMEOUT_MS=120000
# Optional Ollama thinking toggle; use only with a supported model.
MODEL_THINK=
TASK_TIMEOUT_MS=300000
MAX_CONCURRENT_TASKS=2
MAX_TASKS_PER_DAY=100
MAX_OUTPUT_TOKENS=4096
EXECUTOR_IMAGE=node:24-bookworm
# Optional JSON file containing [{"id":"user-id","tokenHash":"sha256 digest"}].
AUTH_USERS_FILE=
# Registry/client only: remote tools are not exposed to this application's agent.
MCP_ENABLE=
CLOUDFLARE_MCP_TOKEN=
STRIPE_MCP_TOKEN=
