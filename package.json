{
  "name": "easy-agent-gpt",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted coding agent workspace for local and OpenAI-compatible models",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build": "node scripts/build.mjs",
    "tools:router": "node scripts/developer-tools.mjs router",
    "tools:app": "node scripts/developer-tools.mjs app",
    "tools:doctor": "node scripts/developer-tools.mjs doctor",
    "cloudflare:whoami": "npm_config_cache=.cache/npm npx -y wrangler@4 whoami",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
